# payment-service, local k3d cluster. Non-secret config only — secrets are in ../secrets.env.
# PORT, DATABASE_URL and NATS_URL are wired by the chart. No quotes: kubectl keeps them.

# Seconds after a booking ends before a payout hands its money over. Must equal view.env's.
SETTLEMENT_SECS=86400
# Only the e2e suite points this elsewhere, at its fake.
STRIPE_API_BASE=https://api.stripe.com
