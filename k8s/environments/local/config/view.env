# view-service, local k3d cluster. Non-secret config only — secrets are in ../secrets.env.
# PORT, DATABASE_URL and NATS_URL are wired by the chart. No quotes: kubectl keeps them.

# Seconds after a booking ends before the wallet shows its money as available. Must equal
# payment.env's, or the wallet offers money the withdraw endpoint refuses (deploy.sh checks).
SETTLEMENT_SECS=86400
