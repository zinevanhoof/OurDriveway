# user-service, local k3d cluster. Non-secret config only — secrets are in ../secrets.env.
# PORT, DATABASE_URL and NATS_URL are wired by the chart. No quotes: kubectl keeps them.

# Avatars must be on this origin. Same value in spot.env and media.env (deploy.sh checks).
MEDIA_BASE=https://pub-840a7b1ce14341a5ba374ccba35a2c6f.r2.dev
# Minutes.
JWT_EXPIRATION=15
# Days.
REFRESH_TOKEN_EXPIRATION=15
# The local cluster is plain HTTP on the LAN IP, where a browser drops a Secure
# cookie and every refresh would log the user out.
COOKIE_SECURE=false
