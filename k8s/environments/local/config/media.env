# media-service, local k3d cluster. Non-secret config only — secrets are in ../secrets.env.
# PORT is wired by the chart; this service has no database and no NATS. No quotes: kubectl
# keeps them.

# Where uploaded images are SERVED from, stamped onto every URL minted. Same value in
# user.env and spot.env, which validate against it. Must be reachable from Stripe too:
# listing photos go onto a Checkout Session.
MEDIA_BASE=https://pub-840a7b1ce14341a5ba374ccba35a2c6f.r2.dev
# The R2 API, where bytes are PUT. The account id is not secret: it is in every presigned URL.
S3_ENDPOINT=https://41b38b255942623d7927f3916220b974.r2.cloudflarestorage.com
# The dev bucket, so local uploads never land beside real listings. The S3 credentials in
# ../secrets.env must be scoped to this bucket.
S3_BUCKET=ourdriveway-dev
# R2 has one region and it is called `auto`. Still signed, so it must match.
S3_REGION=auto
# Seconds a minted upload URL stays usable.
PRESIGN_EXPIRY_SECS=900
# Per-image ceiling in bytes (20 MiB), signed into the URL.
MAX_UPLOAD_BYTES=20971520
