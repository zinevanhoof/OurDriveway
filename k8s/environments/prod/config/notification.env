# notification-service, production. Non-secret config only — secrets are in ../secrets.env.
# PORT and NATS_URL are wired by the chart; it has no database. No quotes: kubectl keeps
# them, so MAIL_FROM is written bare.

# "false" keeps the pod consuming but sends nothing.
NOTIFICATIONS_ENABLED=true
MAIL_FROM=OurDriveway <noreply@mail.ourdriveway.com>
APP_BASE_URL=https://ourdriveway.com
COMPANY_NAME=OurDriveway
# 24h: survives a night's sleep, goes stale in an old inbox.
VERIFY_TOKEN_TTL_SECS=86400
# 1h: a reset link sets a credential, and whoever asked is at their keyboard now.
RESET_TOKEN_TTL_SECS=3600
# Resend template aliases, not UUIDs — they survive editing the template.
TEMPLATE_EMAIL_VERIFICATION=email-verification
TEMPLATE_PASSWORD_RESET=password-reset
