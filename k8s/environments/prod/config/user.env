# user-service, production. Non-secret config only — secrets are in ../secrets.env.
# PORT, DATABASE_URL and NATS_URL are wired by the chart. No quotes: kubectl keeps them.

# Avatars must be on this origin. Same value in spot.env and media.env (deploy.sh checks).
MEDIA_BASE=https://assets.ourdriveway.com
# Minutes.
JWT_EXPIRATION=15
# Days.
REFRESH_TOKEN_EXPIRATION=15
# Production is HTTPS only, through Cloudflare.
COOKIE_SECURE=true
