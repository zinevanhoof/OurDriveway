# Template for k8s/environments/<env>/secrets.env — one per environment, never committed
# (the repo's `*.env` rule covers it). deploy.sh refuses a file whose keys differ from this
# one's or that leaves any empty. Non-secret config is in environments/<env>/config/.
#
# Each service gets only the keys its Config reads — the `secrets` lists in
# chart/values.yaml — never this whole file.
#
# No quotes around values: kubectl keeps them.

# ── Generated: not issued by anyone ──────────────────────────────────────────
# Generate each one separately with `openssl rand -hex 32`. deploy.sh refuses any that is
# under 32 characters, not purely letters and digits (the passwords are spliced into URLs
# unescaped), or equal to another of the four.

# Signs the access tokens user-service mints and every service verifies.
JWT_SECRET=
# Signs verification and reset links (notification mints, user verifies). Must NOT equal
# JWT_SECRET: `JwtClaims` has no audience, so a link signed with the access-token key
# would be accepted as a full session.
EMAIL_TOKEN_SECRET=
# The `yugabyte` role's password — the role's name under PostgreSQL too (`database` in
# chart/values.yaml). Read by the database and by every DATABASE_URL, so the two cannot drift. Set once, at the cluster's first boot — changing it later changes the
# URLs, not the database.
YSQL_PASSWORD=
# The one NATS account's password (`natsUser` in chart/values.yaml). Without it anything
# reaching :4222 could publish a PaymentSucceeded.
NATS_PASSWORD=

# ── Issued by a provider ─────────────────────────────────────────────────────
# spot-service. LocationIQ → Access Tokens.
LOCATIONIQ_API_KEY=

# media-service. Cloudflare R2 → Manage API tokens → an *Account* API token (a User token
# goes inactive if the user leaves), "Object Read & Write", scoped to the S3_BUCKET in
# config/media.env only. A different token per environment.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# notification-service. Resend → API Keys; sending permission is enough.
RESEND_API_KEY=

# payment-service — the only credential here that moves money. Stripe → Developers → API
# keys. A sandbox key (`sk_test_…`) even in prod: this is a portfolio deployment, nobody
# trying it out should be charged.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint registered in the Stripe dashboard at
# https://<host>/api/payment/webhook, subscribed to payment_intent.succeeded and
# payment_intent.payment_failed. Without the right value, anyone could book without paying.
STRIPE_WEBHOOK_SECRET=
