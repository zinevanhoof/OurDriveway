# cp secrets.env.example secrets.env, fill in, never commit.
# The repo's `*.env` gitignore rule already covers secrets.env.
#
# Each service is handed only the keys its own Config reads — the `secrets` lists in
# the chart's values.yaml — never this whole file.
# Non-secret tunables (token lifetimes, the R2 endpoint and bucket, the mail from
# address) live in the chart's values.yaml instead — they belong in review, not in
# a Secret.
#
# ── The four this deployment invents ─────────────────────────────────────────
# JWT_SECRET, EMAIL_TOKEN_SECRET, YSQL_PASSWORD and NATS_PASSWORD are not issued by
# anyone; generate each one, separately:
#
#   openssl rand -hex 32
#
# 64 hex characters: 256 bits, and URL-safe, which matters because the two passwords
# are spliced into DATABASE_URL and NATS_URL. deploy.sh refuses to run if any of the
# four is shorter than 32 characters, contains anything but letters and digits, or if
# JWT_SECRET and EMAIL_TOKEN_SECRET are equal.
JWT_SECRET=
LOCATIONIQ_API_KEY=

# The password for YugabyteDB's `yugabyte` role, read by BOTH sides from this one key
# — the database itself as YSQL_PASSWORD, and every service through the DATABASE_URL
# that templates/services.yaml interpolates it into — so the pair cannot drift into a
# boot-time auth failure.
#
# One key where there used to be two (SURREALDB_USER/SURREALDB_PASS). The role name is
# fixed rather than configurable: it is `yugabyte`, the cluster's own superuser, and a
# second name to keep in step bought nothing.
#
# Together with templates/network-policy.yaml — which closes 5433 to every pod but the
# services and the migrator — this is what stands between the cluster and a superuser
# session on the authoritative store. Generate it; do not type one.
YSQL_PASSWORD=

# The password of the one NATS account (`natsUser` in values.yaml). The broker reads it
# for its `authorization` block and every service gets it inside NATS_URL, from this one
# key. Without it, anything that can reach :4222 can publish a PaymentSucceeded and have
# a booking confirmed.
NATS_PASSWORD=

# Cloudflare R2 → Manage API tokens → *Account* API token (not a User token: those
# go inactive if the user leaves the account). Permission "Object Read & Write",
# scoped to the production bucket only — there is no write-only tier, and the read
# it grants is moot since the bucket is publicly readable anyway.
#
# Use a DIFFERENT token here from the one in apps/services/media-service/.env, so
# the dev credential sitting in plaintext on a laptop cannot reach these objects.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signs the tokens in verification links. notification-service mints them,
# user-service verifies them, so both read this and it must be byte-identical
# across the two.
#
# Must NOT equal JWT_SECRET. `JwtClaims` carries no purpose or audience field, so
# a verification link signed with the access-token key is accepted by `AuthedJwt`
# as a full session — a bearer token mailed in cleartext and left in an inbox
# forever. There is a test in shared/src/email_token.rs that fails if the two are
# ever merged.
EMAIL_TOKEN_SECRET=

# Resend → API Keys. Sending permission is enough; nothing here ever reads.
RESEND_API_KEY=

# payment-service. The only credential in this file that can move money.
#
# Stripe → Developers → API keys. Use a SANDBOX key (`sk_test_…`) here too: this is a
# portfolio deployment and nobody trying it out should be charged. A live key would make
# every test booking a real payment.
STRIPE_SECRET_KEY=

# Verifies that a webhook really came from Stripe. Without it — or with the wrong value —
# `payment_intent.succeeded` cannot be trusted, and confirming a booking on an
# unverified POST would let anyone book without paying.
#
# NOT the same value as in dev. Locally this is the `stripe listen` session's own secret
# (`stripe listen --print-secret`); here it is the signing secret of the webhook
# endpoint you registered in the Stripe dashboard, pointing at
# https://<host>/api/payment/webhook. Subscribe that endpoint to
# payment_intent.succeeded and payment_intent.payment_failed only.
STRIPE_WEBHOOK_SECRET=
