# cp secrets.env.example secrets.env, fill in, never commit.
# The repo's `*.env` gitignore rule already covers secrets.env.
#
# Every service reads JWT_SECRET; spot-service also needs the LocationIQ key.
# Non-secret tunables (token lifetimes) live in the chart's values.yaml instead —
# they belong in review, not in a Secret.
JWT_SECRET=
LOCATIONIQ_API_KEY=
