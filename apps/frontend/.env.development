# Loaded automatically by `npm run dev` (vite mode: development).
# `npm run build` reads .env.production instead — there is no switching code.
#
# Not secret: everything here is inlined into the bundle at build time anyway, which is
# why the root .gitignore un-ignores this file and .env.production by name.


# Stripe SANDBOX publishable key — Developers -> API keys, the `pk_test_…` one.
#
# Public by design: it identifies the account to Stripe.js and can only create and
# confirm payments, never read or refund. The secret key (`sk_test_…`) lives in
# apps/services/payment-service/.env and must never appear in this bundle.
#
# Must belong to the SAME sandbox as that secret key, or the client secret the server
# hands back will not be recognised by the Stripe.js instance loaded here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51U3cN7AL6nkIYVAuuoUn6zM5NcDUsmTaSq9oNhVDi4Uw4ytnSPAZeDt55MnZe2dN7S0JKdXxK6XSv2nVZHnJ4tQc006DL6h0I9

# Where `tauri android dev` sends API calls: the Vite server on this machine's LAN
# address, whose proxy reaches the services (see `apiBase` in src/api/http.ts). Must be
# in the http scope of src-tauri/capabilities/dev-lan.json. The web build ignores it.
VITE_API_BASE=http://192.168.50.29:1420