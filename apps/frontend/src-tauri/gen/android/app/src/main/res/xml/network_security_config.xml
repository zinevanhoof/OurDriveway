<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        `apiBase` in src/api/http.ts is the dev machine's LAN address over plain HTTP.
        Release builds refuse cleartext by default, and the refusal is silent from the
        web layer's side: the app boots fine and every request fails. This permits it
        for that one host, so everything else stays HTTPS-only.

        When the API moves behind a real HTTPS ingress, delete this file, the
        networkSecurityConfig attribute in AndroidManifest.xml, and the LAN address.

        Note this file overrides android:usesCleartextTraffic entirely - that attribute
        is ignored whenever a network security config is set.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.50.29</domain>
    </domain-config>
</network-security-config>
