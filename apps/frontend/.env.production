# Loaded automatically by `npm run build` (vite mode: production), including the
# build `tauri build` runs. `npm run dev` reads .env.development instead.
#
# Not secret: this is a public read URL, and everything here is inlined into the
# bundle at build time anyway.


# Stripe publishable key. Public by design — it identifies the account to Stripe.js and
# can only create and confirm payments, never read or refund.
#
# Still a SANDBOX key (`pk_test_…`) on purpose: this is a portfolio deployment and
# nobody trying it out should be charged. Must match the sandbox of STRIPE_SECRET_KEY in
# k8s/secrets.env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51U3cN7AL6nkIYVAuuoUn6zM5NcDUsmTaSq9oNhVDi4Uw4ytnSPAZeDt55MnZe2dN7S0JKdXxK6XSv2nVZHnJ4tQc006DL6h0I9

# Where the native app sends API calls — see `apiBase` in src/api/http.ts. The web build
# ignores it and stays on relative, same-origin URLs. Must be listed in the http scope of
# src-tauri/capabilities/default.json, or plugin-http refuses every request.
VITE_API_BASE=https://ourdriveway.com
